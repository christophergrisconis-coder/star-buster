# Supabase (Lovable Cloud compatible)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
VITE_SITE_URL=http://localhost:3000
# Production: https://starbuster.acstudioapps.us

# Owner / family docking passcodes (never commit real values).
# If unset, owner docking and the admin dock are disabled entirely.
VITE_OWNER_PASSWORD=
VITE_CO_ADMIN_PASSWORD=
VITE_ADMIN_PASSWORD=

# AI hint coach (OpenAI-compatible / Lovable AI). Optional — the coach
# falls back to the local heuristic hint when no key is configured.
AI_GATEWAY_URL=https://api.openai.com/v1
AI_GATEWAY_KEY=
AI_MODEL=gpt-4o-mini
